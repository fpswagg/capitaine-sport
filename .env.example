# SSS API origin (without /api/v1)
SSS_API_URL=https://sss-api.fpswagg.site
# Store ID of Capitaine Sport in SSS
SSS_STORE_ID=cmtos1olx002eyus16jez6m0r
# Business API key (sss_…) — server-side only: catalog + contact feedback
SSS_API_KEY=

# Public site canonical URL (set to https://capitaine-sport.vercel.app in Vercel)
SITE_URL=http://localhost:3000
# Sign in with SSS — required to enable /dashboard
SSS_OAUTH_CLIENT_ID=
SSS_OAUTH_CLIENT_SECRET=
SSS_OAUTH_SCOPE=profile email business
# Generate a long random value; encrypts the dashboard session cookie
SESSION_SECRET=
# Optional SSS web-app destination
SSS_APP_URL=https://sss.fpswagg.site
# Optional secret to authorize SSS cache revalidation requests
REVALIDATE_SECRET=

# Customer bot (public, safe in the browser)
NEXT_PUBLIC_SSS_API_URL=https://sss.example.com
NEXT_PUBLIC_SSS_BOT_KEY=cb_xxxxxxxxxxxxxxxx
