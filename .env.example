# SSS server (without /api/v1)
SSS_API_URL=https://sss.example.com
# Store id or slug of Capitaine Sport on SSS
SSS_STORE_ID=capitaine-sport
# Business API key (sss_…) — server-side only: catalog + contact feedback
SSS_API_KEY=sss_xxxxxxxxxxxxxxxx

# Customer bot (public, safe in the browser)
NEXT_PUBLIC_SSS_API_URL=https://sss.example.com
NEXT_PUBLIC_SSS_BOT_KEY=cb_xxxxxxxxxxxxxxxx
